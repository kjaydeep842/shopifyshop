<div class="search-modal" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-container">
    <div class="search-input-wrap">
      {% render 'icon-search' %}
      <input type="text" class="search-input" placeholder="Search sunglasses, watches, couple sets..." aria-label="Search site">
      <button type="button" data-action="close-search" aria-label="Close Search">
        {% render 'icon-close' %}
      </button>
    </div>
    <div class="search-results">
      <p class="text-muted" style="font-size:0.85rem;color:var(--color-text-muted);">Start typing to find products, collections, or style articles...</p>
    </div>
  </div>
</div>
