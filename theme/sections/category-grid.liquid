<section class="section category-section">
  <div class="container">
    <div class="section-header">
      <div class="subheading">CURATED SELECTION</div>
      <h2 class="heading-lg section-header__title">EXPLORE CATEGORIES</h2>
      <p class="section-header__desc">Discover our signature luxury lines meticulously crafted for modern tastemakers.</p>
    </div>

    <div class="category-grid">
      <div class="category-card">
        <img src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=1000&q=85" alt="Sunglasses" loading="lazy">
        <div class="category-card__overlay">
          <h3 class="heading-md category-card__title">LUXURY EYEWEAR</h3>
          <p class="category-card__subtitle">UV400 Polarized Architectural Frames</p>
          <a href="/collections/sunglasses" class="btn btn-outline-white" style="align-self:flex-start;">SHOP SUNGLASSES</a>
        </div>
      </div>

      <div class="category-card">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1000&q=85" alt="Timepieces" loading="lazy">
        <div class="category-card__overlay">
          <h3 class="heading-md category-card__title">PRECISION TIMEPIECES</h3>
          <p class="category-card__subtitle">Sapphire Crystal & Swiss Chronographs</p>
          <a href="/collections/watches" class="btn btn-outline-white" style="align-self:flex-start;">DISCOVER WATCHES</a>
        </div>
      </div>

      <div class="category-card">
        <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1000&q=85" alt="Couple Collections" loading="lazy">
        <div class="category-card__overlay">
          <h3 class="heading-md category-card__title">COUPLE COLLECTION</h3>
          <p class="category-card__subtitle">Matching His & Her Signature Sets</p>
          <a href="/collections/couple-collection" class="btn btn-outline-white" style="align-self:flex-start;">EXPLORE SETS</a>
        </div>
      </div>

      <div class="category-card">
        <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=1000&q=85" alt="Fashion Accessories" loading="lazy">
        <div class="category-card__overlay">
          <h3 class="heading-md category-card__title">FINE ACCESSORIES</h3>
          <p class="category-card__subtitle">Leather Goods & Italian Silk Accessories</p>
          <a href="/collections/accessories" class="btn btn-outline-white" style="align-self:flex-start;">VIEW ACCESSORIES</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "presets": [
    {
      "name": "Category Grid"
    }
  ]
}
{% endschema %}
