<section class="section main-account-section">
  <div class="container">
    {% render 'breadcrumbs' %}
    
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;">
      <div>
        <h1 class="heading-lg" style="margin-bottom:6px;">MY ACCOUNT</h1>
        <p style="color:var(--color-text-muted);">Welcome back, {{ customer.first_name | default: 'Client' }}!</p>
      </div>
      <a href="/account/logout" class="btn btn-secondary" style="padding:8px 16px;font-size:0.75rem;">LOG OUT</a>
    </div>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:40px;">
      <div>
        <h3 class="heading-sm" style="margin-bottom:20px;border-bottom:1px solid var(--color-border);padding-bottom:12px;">ORDER HISTORY</h3>
        {% if customer.orders.size > 0 %}
          <table style="width:100%;border-collapse:collapse;font-size:0.875rem;">
            <thead>
              <tr style="border-bottom:1px solid var(--color-border);text-align:left;">
                <th style="padding:10px 0;">Order</th>
                <th style="padding:10px 0;">Date</th>
                <th style="padding:10px 0;">Status</th>
                <th style="padding:10px 0;">Total</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr style="border-bottom:1px solid var(--color-border);">
                  <td style="padding:12px 0;"><a href="{{ order.customer_url }}" style="color:var(--color-accent);font-weight:600;">{{ order.name }}</a></td>
                  <td style="padding:12px 0;">{{ order.created_at | date: "%b %d, %Y" }}</td>
                  <td style="padding:12px 0;">{{ order.financial_status_label }}</td>
                  <td style="padding:12px 0;font-weight:600;">{{ order.total_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div style="padding:32px;background:var(--color-bg-secondary);border-radius:8px;text-align:center;">
            <p style="color:var(--color-text-muted);margin-bottom:16px;">You haven't placed any orders yet.</p>
            <a href="/collections/all" class="btn btn-primary">SHOP NOW</a>
          </div>
        {% endif %}
      </div>

      <div>
        <h3 class="heading-sm" style="margin-bottom:20px;border-bottom:1px solid var(--color-border);padding-bottom:12px;">ACCOUNT DETAILS</h3>
        <div style="background:var(--color-bg-surface);padding:24px;border:1px solid var(--color-border);border-radius:8px;">
          <div style="font-weight:600;margin-bottom:6px;">{{ customer.name | default: 'Valeria Client' }}</div>
          <div style="color:var(--color-text-muted);font-size:0.85rem;margin-bottom:16px;">{{ customer.email }}</div>
          {% if customer.default_address %}
            <div style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.6;">
              {{ customer.default_address.address1 }}<br>
              {{ customer.default_address.city }}, {{ customer.default_address.zip }}<br>
              {{ customer.default_address.country }}
            </div>
          {% endif %}
          <a href="/account/addresses" class="btn btn-secondary btn-full" style="margin-top:20px;padding:8px 16px;font-size:0.75rem;">MANAGE ADDRESSES</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
