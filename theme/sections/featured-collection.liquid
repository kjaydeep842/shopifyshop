<section class="section featured-collection-section">
  <div class="container">
    <div class="section-header">
      <div class="subheading">{{ section.settings.subheading | default: "ICONIC SELECTION" }}</div>
      <h2 class="heading-lg section-header__title">{{ section.settings.heading | default: "FEATURED BEST SELLERS" }}</h2>
      <p class="section-header__desc">Our most coveted pieces crafted to perfection.</p>
    </div>

    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        {% comment %} Fallback items when previewing without assigned Shopify admin collection {% endcomment %}
        <div class="product-card">
          <div class="product-card__media">
            <span class="badge badge-sale" style="position:absolute;top:12px;left:12px;z-index:2;">-20% OFF</span>
            <button type="button" class="product-card__wishlist" data-wishlist-toggle data-product-id="101" data-product-title="AURELIA GOLD AVIATOR" data-product-price="₹3,499.00" data-product-image="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80">
              {% render 'icon-heart' %}
            </button>
            <img 
              src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80" 
              class="product-card__img" 
              alt="Aurelia Gold Aviator"
              style="cursor:pointer;"
              onclick="openQuickView({id:101,title:'AURELIA GOLD AVIATOR',price:'₹3,499.00',comparePrice:'₹4,499.00',image:'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80',description:'Ultra-lightweight titanium tear-drop aviator with gradient champagne UV400 lenses.'})"
            >
          </div>
          <div class="product-card__content">
            <div 
              class="product-card__title"
              style="cursor:pointer;"
              onclick="openQuickView({id:101,title:'AURELIA GOLD AVIATOR',price:'₹3,499.00',comparePrice:'₹4,499.00',image:'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80',description:'Ultra-lightweight titanium tear-drop aviator with gradient champagne UV400 lenses.'})"
            >AURELIA GOLD AVIATOR</div>
            <div class="product-card__rating">{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %} (4.9)</div>
            <div class="product-card__price"><span class="price__regular">₹3,499.00</span><span class="price__compare">₹4,499.00</span></div>
            <div style="margin-top:14px;">
              <form method="post" action="/cart/add" data-product-title="AURELIA GOLD AVIATOR" data-product-price="3499" data-product-image="https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=600&q=80">
                <button type="submit" class="btn btn-primary btn-full" style="padding:10px 16px;font-size:0.75rem;">ADD TO CART</button>
              </form>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div style="text-align:center;margin-top:48px;">
      <a href="/collections/all" class="btn btn-secondary">VIEW ENTIRE COLLECTION</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED BEST SELLERS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ICONIC SELECTION"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
