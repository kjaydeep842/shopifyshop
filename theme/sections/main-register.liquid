<section class="section main-register-section">
  <div class="container" style="max-width:480px;">
    {% render 'breadcrumbs' %}
    <div style="background:var(--color-bg-surface);padding:40px 32px;border-radius:var(--radius-md);border:1px solid var(--color-border);box-shadow:var(--shadow-sm);">
      <h1 class="heading-md" style="margin-bottom:8px;text-align:center;">CREATE AN ACCOUNT</h1>
      <p style="text-align:center;color:var(--color-text-muted);font-size:0.875rem;margin-bottom:32px;">Join Valeria & Co. for exclusive private sales and priority tracking.</p>

      {% form 'create_customer' %}
        {{ form.errors | default_errors }}

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
          <div>
            <label for="FirstName" style="display:block;font-size:0.8rem;font-weight:600;text-transform:uppercase;margin-bottom:6px;">First Name</label>
            <input type="text" name="customer[first_name]" id="FirstName" required style="width:100%;padding:12px 16px;border:1px solid var(--color-border);border-radius:4px;font-family:var(--font-body);">
          </div>
          <div>
            <label for="LastName" style="display:block;font-size:0.8rem;font-weight:600;text-transform:uppercase;margin-bottom:6px;">Last Name</label>
            <input type="text" name="customer[last_name]" id="LastName" required style="width:100%;padding:12px 16px;border:1px solid var(--color-border);border-radius:4px;font-family:var(--font-body);">
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label for="Email" style="display:block;font-size:0.8rem;font-weight:600;text-transform:uppercase;margin-bottom:6px;">Email Address</label>
          <input type="email" name="customer[email]" id="Email" required style="width:100%;padding:12px 16px;border:1px solid var(--color-border);border-radius:4px;font-family:var(--font-body);">
        </div>

        <div style="margin-bottom:24px;">
          <label for="CreatePassword" style="display:block;font-size:0.8rem;font-weight:600;text-transform:uppercase;margin-bottom:6px;">Password</label>
          <input type="password" name="customer[password]" id="CreatePassword" required style="width:100%;padding:12px 16px;border:1px solid var(--color-border);border-radius:4px;font-family:var(--font-body);">
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="margin-bottom:16px;">CREATE ACCOUNT</button>
      {% endform %}

      <div style="text-align:center;font-size:0.85rem;color:var(--color-text-muted);">
        Already registered? <a href="/account/login" style="color:var(--color-accent);font-weight:600;">Sign In</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
