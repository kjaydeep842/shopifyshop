<section class="section reviews-section">
  <div class="container">
    <div class="section-header">
      <div class="subheading">CLIENT VERDICTS</div>
      <h2 class="heading-lg section-header__title">WHAT OUR CLIENTS SAY</h2>
      <p class="section-header__desc">Over 15,000+ satisfied luxury buyers worldwide.</p>
    </div>

    <div class="reviews-grid" style="display:grid;grid-template-columns:repeat(3, 1fr);gap:24px;">
      <div style="background:var(--color-bg-surface);padding:28px;border-radius:var(--radius-md);border:1px solid var(--color-border);">
        <div style="color:var(--color-accent);margin-bottom:12px;">★★★★★</div>
        <p style="font-style:italic;font-size:0.9rem;margin-bottom:16px;">"The quality of the Monarch polarized frame is comparable to top Italian heritage fashion houses. Exceeded my expectations!"</p>
        <div style="font-weight:600;font-size:0.85rem;">- Rohan V. <span style="color:var(--color-success);font-size:0.75rem;margin-left:6px;">✓ Verified Buyer</span></div>
      </div>

      <div style="background:var(--color-bg-surface);padding:28px;border-radius:var(--radius-md);border:1px solid var(--color-border);">
        <div style="color:var(--color-accent);margin-bottom:12px;">★★★★★</div>
        <p style="font-style:italic;font-size:0.9rem;margin-bottom:16px;">"Purchased the Couple Chronograph Watch Set for our anniversary. The presentation box and gold finish are breathtaking."</p>
        <div style="font-weight:600;font-size:0.85rem;">- Ananya & Vikram <span style="color:var(--color-success);font-size:0.75rem;margin-left:6px;">✓ Verified Buyer</span></div>
      </div>

      <div style="background:var(--color-bg-surface);padding:28px;border-radius:var(--radius-md);border:1px solid var(--color-border);">
        <div style="color:var(--color-accent);margin-bottom:12px;">★★★★★</div>
        <p style="font-style:italic;font-size:0.9rem;margin-bottom:16px;">"Fast delivery in 2 days, exquisite velvet packaging, and crisp anti-glare lenses. 10/10 shopping experience!"</p>
        <div style="font-weight:600;font-size:0.85rem;">- Devina K. <span style="color:var(--color-success);font-size:0.75rem;margin-left:6px;">✓ Verified Buyer</span></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
